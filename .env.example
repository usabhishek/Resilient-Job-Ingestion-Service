# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Server
PORT=8000
HOST=0.0.0.0

# Supabase PostgreSQL Connection
# Direct connection string for PostgreSQL (AsyncPG):
DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres
# Fallback SQLite for offline testing if Supabase is not provided:
# DATABASE_URL=sqlite+aiosqlite:///./jobs.db

# Ingestion Rate Limiting & Timeouts
DEFAULT_RATE_LIMIT_RPS=2.0
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
HTTP_INITIAL_BACKOFF_SECONDS=1.0
HTTP_MAX_BACKOFF_SECONDS=8.0
