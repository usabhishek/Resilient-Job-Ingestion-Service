# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Server
PORT=8000
HOST=0.0.0.0

# MongoDB connection (PyMongo)
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=job_ingestion

# Login
SESSION_DAYS=7
# An admin account is created at startup when BOTH are set. Choose your own strong password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Ingestion Rate Limiting & Timeouts
DEFAULT_RATE_LIMIT_RPS=2.0
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
HTTP_INITIAL_BACKOFF_SECONDS=1.0
HTTP_MAX_BACKOFF_SECONDS=8.0
